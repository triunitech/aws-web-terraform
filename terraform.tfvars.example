# このファイルを terraform.tfvars にコピーして値を編集してください。
# terraform.tfvars は .gitignore 済みです (コミットしないでください)。

project_name = "smallweb"
environment  = "prod"
aws_region   = "ap-northeast-1"

# ---- ネットワーク ------------------------------------------------------
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
enable_nat_gateway   = true

# ---- ALB ---------------------------------------------------------------
# 事前に ACM (ap-northeast-1) で発行した証明書の ARN を指定します。
acm_certificate_arn     = "arn:aws:acm:ap-northeast-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
alb_allowed_cidrs       = ["0.0.0.0/0"]
alb_deletion_protection = false
health_check_path       = "/"

# ---- EC2 / Auto Scaling -------------------------------------------------
instance_type          = "t3.small"
asg_min_size           = 2
asg_max_size           = 4
asg_desired_capacity   = 2
root_volume_size       = 20
cpu_target_utilization = 60

# ---- RDS ---------------------------------------------------------------
db_engine_version        = "8.0"
db_instance_class        = "db.t3.micro"
db_name                  = "appdb"
db_username              = "dbadmin"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_multi_az              = false
db_deletion_protection   = true
db_skip_final_snapshot   = false
db_backup_retention_days = 7
db_snapshot_identifier   = ""

# ---- 監視 --------------------------------------------------------------
# 通知先メールアドレス (apply 後に届く確認メールの承認が必要)
alarm_email                            = "ops@example.com"
ec2_cpu_alarm_threshold                = 80
rds_cpu_alarm_threshold                = 80
rds_free_storage_alarm_threshold_bytes = 2147483648
rds_connections_alarm_threshold        = 50

# ---- AWS Backup ---------------------------------------------------------
backup_retention_days = 35
backup_schedule_cron  = "cron(0 18 * * ? *)"

# ---- タグ --------------------------------------------------------------
additional_tags = {
  Owner      = "infra-team"
  CostCenter = "web"
}
